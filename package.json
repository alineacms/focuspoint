{
  "name": "@alinea/focuspoint",
  "version": "0.1.0",
  "description": "Find the focus point of an image so the main subject survives any crop. A 4 kB heuristic or a tiny learned model.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/alineacms/focuspoint.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./model/browser": {
      "types": "./dist/model/browser.d.ts",
      "default": "./dist/model/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p .",
    "test": "bun test",
    "size": "bun scripts/size.ts",
    "eval": "bun eval/run.ts",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "demo": "bun scripts/demo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "sharp": "^0.35.5",
    "smartcrop": "^2.0.5",
    "typescript": "7"
  }
}
